LLM_PROVIDER=openai          # openai | gemini
OPENAI_API_KEY=
GOOGLE_API_KEY=
POSTGRES_USER=shiprisk
POSTGRES_PASSWORD=           # set a real password; never commit .env
API_KEY=                     # sent by clients in the X-API-Key header
AS_OF=                       # optional fixed scoring date (YYYY-MM-DD); empty means today
WEB_PORT=8080                # host port for the dashboard
CHAINLIT_AUTH_SECRET=        # signs the chat session; run `chainlit create-secret`
# MLFLOW_DIR=                # shadow-model store; the API defaults to api/mlflow (sqlite plus the model pickle)
LANGSMITH_TRACING=true       # each fleet chat and RAGWire call is one trace when the key below is set
LANGSMITH_API_KEY=           # from https://smith.langchain.com
LANGSMITH_PROJECT=ship-risk
# The chat sign-in password is OPENAI_API_KEY. The username is stored on each answer.
